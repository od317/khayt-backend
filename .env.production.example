# خيط — production environment.
#
# Copy this file to .env.production and fill in the real values.
# .env.production is gitignored and must NOT be committed.
#
#   cp .env.production.example .env.production
#
# The values below are placeholders. Replace every CHANGE_ME.

NODE_ENV=production
PORT=3000

# Postgres is inside the compose network, so the host is the service
# name (`postgres`), not localhost. Port 5432 is the container port;
# nothing is published to the host.
DATABASE_URL=postgresql://khayt:CHANGE_ME@postgres:5432/khayt

# Redis is inside the compose network too.
REDIS_URL=redis://redis:6379

# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ACCESS_EXPIRES=7d
JWT_REFRESH_EXPIRES=30d

# Required at boot. Missing SMTP_* values crash the process and nginx returns 502.
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
SMTP_FROM=CHANGE_ME

# Firebase Cloud Messaging (Android push). Required in production.
FIREBASE_PROJECT_ID=CHANGE_ME
FIREBASE_CLIENT_EMAIL=CHANGE_ME
# PEM with literal \n between lines, wrapped in quotes:
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nCHANGE_ME\n-----END PRIVATE KEY-----\n"

# Exposes /api/docs. Leave unset/false in real production.
# SWAGGER_ENABLED=true