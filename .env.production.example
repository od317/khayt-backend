# خيط — production environment.
#
# Copy this file to .env.production and fill in the real values.
# .env.production is gitignored and must NOT be committed.
#
#   cp .env.production.example .env.production
#
# The values below are placeholders. Replace every CHANGE_ME.

NODE_ENV=production
PORT=3000

# Postgres is inside the compose network, so the host is the service
# name (`postgres`), not localhost. Port 5432 is the container port;
# nothing is published to the host.
DATABASE_URL=postgresql://khayt:CHANGE_ME@postgres:5432/khayt

# Redis is inside the compose network too.
REDIS_URL=redis://redis:6379

# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d