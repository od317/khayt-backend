// خيط — Database Schema
// Derived from 02-domain.md. This file is the source of truth for the
// database shape.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  employee
  workshop
  institute
  store
  // internal
  super_admin
  admin
  inventory
  delivery
}

enum BusinessType {
  workshop
  institute
  store
}

enum PostType {
  job_seeking
  job_offering
  service_offering
  service_requesting
  product_offering
  material_offering
  material_requesting
  reel
}

enum MediaType {
  none
  image
  video
}

enum OrderStatus {
  review
  preparing
  ready
  in_transit
  delivered
  cancelled
  failed
}

enum DeliveryStatus {
  unassigned
  in_transit
  delivered
  failed
}

enum PaymentType {
  cash
  credit
}

enum BillStatus {
  paid
  unpaid
  partial
}

enum NotificationType {
  order_placed
  order_status
  order_delivered
  order_cancelled
  new_comment
  new_like
  receiving_confirmed
  post_moderated 
}

enum CategoryApplies {
  post
  product
  business      // deprecated — kept for backwards compatibility
  workshop      // مصانع / مشاغل
  institute     // معاهد
  store         // متاجر
  workshop_institute // workshop + institute
  both
}

enum PostOptionKind {
  specialty
  skill
  work_type
  salary_type
  service_place
  pricing
  sell_method
  price_method
  condition
}

// ============================================================
// USERS
// ============================================================

model User {
  id               String   @id @default(uuid())
  role             String
  name             String
  phone            String?  @unique
  email            String?  @unique
  passwordHash     String?
  bio              String?
  avatarUrl        String?
  availableForWork Boolean  @default(true)
  verified         Boolean  @default(false)
  suspended        Boolean  @default(false)
  onboardingCompleted Boolean @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  deliveryAddress String?
  deliveryLat     Float?
  deliveryLng     Float?

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])

  business     Business?      @relation("BusinessOwner")
  posts        Post[]
  comments     Comment[]
  likes        Like[]
  orders       Order[]        @relation("StoreOrders")
  deliveries   Delivery[]     @relation("DriverDeliveries")
  payments     Payment[]
  receiving    Receiving[]
  notifications Notification[]
  deviceTokens DeviceToken[]
  savedPosts   SavedPost[]
  savedBusinesses SavedBusiness[]
  savedMarketers  SavedMarketer[]

  @@index([role])
  @@index([phone])
  @@index([email])
  @@index([locationId])
}

model Role {
  id          String   @id @default(uuid())
  value       String   @unique
  label       String
  description String  @default("")
  selectable  Boolean @default(true)
  system      Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([selectable, sortOrder])
}

model Location {
  id        String     @id @default(uuid())
  name      String
  parentId  String?
  parent    Location?  @relation("LocationTree", fields: [parentId], references: [id])
  children  Location[] @relation("LocationTree")
  sortOrder Int        @default(0)
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())

  users User[]

  @@index([parentId])
  @@index([active])
}

// ============================================================
// BUSINESSES
// ============================================================

model Business {
  id          String       @id @default(uuid())
  ownerId     String   @unique
  type        BusinessType
  name        String
  location    String
  description String?
  phone       String?
  imageUrl    String?
  verified    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // type-specific
  capacity    String?
  equipment   String?
  minOrder    String?
  experience  String?
  services    String[]  @default([])
  duration    String?
  topics      String[]

  // relations
  owner      User            @relation("BusinessOwner", fields: [ownerId], references: [id])
  products   Product[]
  supply     Supply[]
  posts      Post[]
  receiving  Receiving[]
  bills      Bill[]
  orderLines OrderLine[]
  savedBy    SavedBusiness[]
  categories BusinessCategory[]   // 👈 ADDED

  @@index([type])
  @@index([location])
  @@index([ownerId])
}

model BusinessCategory {
  businessId String
  categoryId String

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  @@id([businessId, categoryId])
}

// ============================================================
// PRODUCTS
// ============================================================

model Product {
  id          String   @id @default(uuid())
  businessId  String
  name        String
  category    String
  description String?
  images      String[]
  unit        String
  price       Int
  posts Post[]
  inWarehouse Boolean  @default(false)
  available   Boolean  @default(true)
  guarantee   Boolean  @default(false)
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants  Json?
  packaging Json?
  discount  Json?
  offer     String?

  business      Business        @relation(fields: [businessId], references: [id])
  supply        Supply[]
  orderLines    OrderLine[]
  receivingLines ReceivingLine[]
  billLines     BillLine[]

  @@index([businessId])
  @@index([inWarehouse])
  @@index([category])
}

// ============================================================
// SUPPLY
// ============================================================

model Supply {
  id        String   @id @default(uuid())
  businessId String
  productId String
  sent      Int
  remaining Int      @default(0)
  unitPrice Int
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@unique([businessId, productId])
  @@index([businessId])
}

// ============================================================
// POSTS
// ============================================================

model Post {
  id        String    @id @default(uuid())
  authorId  String
  businessId String?
  type      PostType?
  title     String?
  body      String
  media     MediaType @default(none)
  imageUrls String[]
  videoUrl  String?
  location  String?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt  DateTime?

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  specialty    String?
  experience   String?
  workType     String[]
  skills       String[]
  salary       String?
  salaryType   String?
  pricing      String?
  servicePlace String?
  sellMethod   String?
  priceMethod  String?
  condition    String?
  price        String?

  author     User           @relation(fields: [authorId], references: [id])
  business   Business?      @relation(fields: [businessId], references: [id])
  categories PostCategory[]
  comments   Comment[]
  likes      Like[]
  savedBy    SavedPost[]

  @@index([authorId])
  @@index([type])
  @@index([active])
  @@index([createdAt])
}

// ============================================================
// POST OPTIONS (admin-managed form chips)
// ============================================================

model PostOption {
  id        String         @id @default(uuid())
  kind      PostOptionKind
  postTypes PostType[]
  label     String
  parentId  String?
  sortOrder Int            @default(0)
  active    Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  parent   PostOption?  @relation("PostOptionTree", fields: [parentId], references: [id])
  children PostOption[] @relation("PostOptionTree")

  @@index([kind, active])
  @@index([parentId])
}

// ============================================================
// CATEGORIES
// ============================================================

model Category {
  id        String         @id @default(uuid())
  name      String
  slug      String         @unique
  appliesTo CategoryApplies @default(both)
  sortOrder Int            @default(0)

  posts      PostCategory[]
  businesses BusinessCategory[]
}

model PostCategory {
  postId     String
  categoryId String

  post     Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  @@id([postId, categoryId])
}

// ============================================================
// COMMENTS AND LIKES
// ============================================================

model Comment {
  id        String   @id @default(uuid())
  postId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@index([postId])
}

model Like {
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
}

// ============================================================
// SAVED
// ============================================================

model SavedPost {
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
}

model SavedBusiness {
  userId     String
  businessId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id])
  business Business @relation(fields: [businessId], references: [id])

  @@id([userId, businessId])
}

model SavedMarketer {
  userId     String
  marketerId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id])
  marketer Marketer @relation(fields: [marketerId], references: [id])

  @@id([userId, marketerId])
}

// ============================================================
// ORDERS
// ============================================================

model Order {
  id        String      @id @default(uuid())
  number    String      @unique
  storeId   String
  status    OrderStatus @default(review)
  total     Int         @default(0)
  pieces    Int         @default(0)
  address   String      @default("")
  lat       Float?
  lng       Float?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  store    User            @relation("StoreOrders", fields: [storeId], references: [id])
  lines    OrderLine[]
  delivery DeliveryOrder[]

  @@index([storeId])
  @@index([status])
  @@index([createdAt])
}

model OrderLine {
  id         String  @id @default(uuid())
  orderId    String
  productId  String
  businessId String
  quantity   Int
  unitPrice  Int
  picked     Boolean @default(false)

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])
  business Business @relation(fields: [businessId], references: [id])

  @@index([orderId])
  @@index([businessId])
}

// ============================================================
// DELIVERY
// ============================================================

model Delivery {
  id          String         @id @default(uuid())
  number      String         @unique
  driverId    String?
  status      DeliveryStatus @default(unassigned)
  area        String
  createdAt   DateTime       @default(now())
  deliveredAt DateTime?

  driver User?           @relation("DriverDeliveries", fields: [driverId], references: [id])
  orders DeliveryOrder[]

  @@index([status])
  @@index([driverId])
}

model DeliveryOrder {
  deliveryId String
  orderId    String

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  order    Order    @relation(fields: [orderId], references: [id])

  @@id([deliveryId, orderId])
  @@unique([orderId])
}

// ============================================================
// RECEIVING
// ============================================================

model Receiving {
  id          String      @id @default(uuid())
  number      String      @unique
  businessId  String
  receivedAt  DateTime    @default(now())
  paymentType PaymentType
  createdBy   String
  createdAt   DateTime    @default(now())

  business Business        @relation(fields: [businessId], references: [id])
  creator  User            @relation(fields: [createdBy], references: [id])
  lines    ReceivingLine[]
  bill     Bill?

  @@index([businessId])
}

model ReceivingLine {
  id          String @id @default(uuid())
  receivingId String
  productId   String
  quantity    Int
  unitPrice   Int

  receiving Receiving @relation(fields: [receivingId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@index([receivingId])
}

// ============================================================
// BILLS AND PAYMENTS
// ============================================================

model Bill {
  id          String      @id @default(uuid())
  number      String      @unique
  businessId  String
  receivingId String      @unique
  paymentType PaymentType
  status      BillStatus  @default(unpaid)
  issuedAt    DateTime    @default(now())
  dueAt       DateTime?
  total       Int         @default(0)
  paid        Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  business  Business   @relation(fields: [businessId], references: [id])
  receiving Receiving  @relation(fields: [receivingId], references: [id])
  lines     BillLine[]
  payments  Payment[]

  @@index([businessId])
  @@index([status])
}

model BillLine {
  id        String @id @default(uuid())
  billId    String
  productId String
  quantity  Int
  unitPrice Int

  bill    Bill    @relation(fields: [billId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([billId])
}

model Payment {
  id         String   @id @default(uuid())
  billId     String
  amount     Int
  paidAt     DateTime @default(now())
  recordedBy String

  bill     Bill @relation(fields: [billId], references: [id])
  recorder User @relation(fields: [recordedBy], references: [id])

  @@index([billId])
}

// ============================================================
// DIRECTORY (no accounts)
// ============================================================

model Marketer {
  id          String   @id @default(uuid())
  name        String
  location    String
  description String?
  phone       String
  channels    String[]
  areas       String[]
  createdAt   DateTime @default(now())

  savedBy SavedMarketer[]
}

model ShippingCompany {
  id           String   @id @default(uuid())
  name         String
  location     String
  verified     Boolean  @default(false)
  coverage     String[]
  deliveryTime String
  pricing      String?
  fleet        String?
  phone        String
  createdAt    DateTime @default(now())
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id        String           @id @default(uuid())
  userId    String
  actorId   String?
  type      NotificationType
  title     String
  body      String
  linkTo    String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================================
// AUDIT
// ============================================================

enum StockMovementType {
  in
  out
}

model StockMovement {
  id         String   @id @default(uuid())
  supplyId   String
  type       StockMovementType
  quantity   Int
  reference  String?
  createdAt  DateTime @default(now())

  @@index([supplyId])
  @@index([createdAt])
}